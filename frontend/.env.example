# Local backend (see backend/server.js — default port 8080)
VITE_API_URL=http://localhost:8080/api

# Production builds use .env.production (Render API). You can also set VITE_API_URL
# in the Render Static Site environment and rebuild.

# On the Render backend Web Service, set FRONTEND_URL to this app’s public URL, e.g.:
# FRONTEND_URL=https://cleb-easy.onrender.com
